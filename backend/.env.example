PORT=8080
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_PUBLIC_URL=
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=change-me-livekit-secret
LIVEKIT_EGRESS_ENABLED=true
LIVEKIT_EGRESS_AUDIO_ONLY=false
LIVEKIT_EGRESS_LAYOUT=grid
LIVEKIT_EGRESS_FILE_PREFIX=alemlive
LIVEKIT_EGRESS_PUBLIC_BASE_URL=http://localhost:9000/alemlive-recordings
LIVEKIT_EGRESS_WEBHOOK_URL=http://host.docker.internal:8080/api/livekit/webhook
LIVEKIT_S3_BUCKET=alemlive-recordings
LIVEKIT_S3_REGION=us-east-1
LIVEKIT_S3_ENDPOINT=http://host.docker.internal:9000
LIVEKIT_S3_ACCESS_KEY=alemlive
LIVEKIT_S3_SECRET=change-me-minio-password
LIVEKIT_S3_SESSION_TOKEN=
LIVEKIT_S3_FORCE_PATH_STYLE=true
# Use participant_tracks when you need speaker names from LiveKit audio tracks.
# It still records room-composite video for report playback and falls back to
# room_composite if participant audio track IDs are not available.
RECORDING_MODE=room_composite
RECORDING_FALLBACK_MODE=room_composite
ENABLE_DIARIZATION_FALLBACK=true
ENABLE_SPEAKER_MANUAL_MAPPING=true
TRANSCRIPT_PREFER_PARTICIPANT_NAMES=true
TOKEN_TTL_MINUTES=120
ALLOWED_ORIGINS=http://localhost:5173
KEYCLOAK_ISSUER_URL=http://localhost:8080/realms/alemlive
KEYCLOAK_JWKS_URL=
KEYCLOAK_TOKEN_URL=
KEYCLOAK_CLIENT_ID=alemlive
LLM_BASE_URL=https://llm.nitec.kz
LLM_API_KEY=
DEFAULT_LLM_MODEL=openai/gpt-oss-120b
LLM_MODEL=openai/gpt-oss-120b
STT_BASE_URL=https://llm.nitec.kz
STT_API_KEY=
DEFAULT_STT_MODEL=openai/whisper-large-v3
STT_MODEL=openai/whisper-large-v3
STT_TIMEOUT_SECONDS=900
DIARIZATION_BASE_URL=http://localhost:8091
DIARIZATION_API_KEY=
DIARIZATION_TIMEOUT_SECONDS=900
LLM_TIMEOUT_SECONDS=60
REPORTS_STORAGE_PATH=data/reports.json
RECORDINGS_STORAGE_PATH=data/recordings
DEMO_REPORTS_ENABLED=false
CHAT_HISTORY_S3_BUCKET=alemlive-chat-history

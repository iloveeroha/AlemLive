# Copy this file to .env when testing calls from another computer on the same network.
# Use your host machine IP address, not 127.0.0.1.
LIVEKIT_NODE_IP=10.111.186.181

# Usually leave this empty. Backend will return ws(s)://<frontend-host>/livekit.
LIVEKIT_PUBLIC_URL=

# Optional: use a LAN-reachable URL if another computer needs to open raw MinIO recordings.
LIVEKIT_EGRESS_PUBLIC_BASE_URL=http://10.111.186.181:9000/alemlive-recordings

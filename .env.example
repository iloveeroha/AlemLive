# Copy to .env for local Docker Compose overrides.
# localhost works for testing on the same machine.
APP_HOST=127.0.0.1
LIVEKIT_NODE_IP=127.0.0.1
KEYCLOAK_PUBLIC_URL=http://localhost:8080

# For another computer on the same LAN, replace the three values above with
# your current Windows IPv4 address and rebuild the frontend:
# APP_HOST=YOUR_LAN_IP
# LIVEKIT_NODE_IP=YOUR_LAN_IP
# KEYCLOAK_PUBLIC_URL=http://YOUR_LAN_IP:8080

LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=change-me-livekit-secret
LIVEKIT_PUBLIC_URL=

MINIO_ROOT_USER=alemlive
MINIO_ROOT_PASSWORD=change-me-minio-password
MINIO_BUCKET=alemlive-recordings
LIVEKIT_EGRESS_PUBLIC_BASE_URL=http://localhost:9000/alemlive-recordings

LLM_BASE_URL=https://llm.nitec.kz
LLM_API_KEY=
DEFAULT_LLM_MODEL=openai/gpt-oss-120b

STT_BASE_URL=https://llm.nitec.kz
STT_API_KEY=
DEFAULT_STT_MODEL=openai/whisper-large-v3

HF_TOKEN=
DIARIZATION_BASE_URL=http://diarization:8091
